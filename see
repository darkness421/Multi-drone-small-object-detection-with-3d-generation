#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

SESSION=${1:-server-training-dual-view}

preferred_training_session() {
  local session
  for session in \
    server-proposed-ablation \
    server-paper-yolo-comparison \
    server-extra-comparison-small \
    server-extra-comparison-medium \
    server-fresh-baselines \
    server-fresh-baselines-resume \
    server-visdrone-baselines; do
    if tmux has-session -t "$session" 2>/dev/null; then
      echo "$session"
      return 0
    fi
  done
  return 1
}

preferred_view_session() {
  if tmux has-session -t server-training-dual-view 2>/dev/null; then
    echo server-training-dual-view
    return 0
  fi
  preferred_training_session
}

case "${1:-view}" in
  view|dual|"")
    SESSION=$(preferred_view_session || true)
    SESSION=${SESSION:-server-training-dual-view}
    ;;
  train|raw)
    SESSION=$(preferred_training_session || true)
    SESSION=${SESSION:-server-proposed-ablation}
    ;;
  mon|monitor)
    SESSION=server-baseline-monitor
    ;;
  gpu)
    exec watch -n 2 nvidia-smi
    ;;
  help|-h|--help)
    cat <<'EOF'
Short training monitor commands:

  ./see          split GPU0/GPU1 live training view
  ./see train    raw active training tmux session
  ./see mon      monitor dashboard/logs/resources
  ./see gpu      GPU usage only

Detach without stopping training:
  Ctrl+b, then d
EOF
    exit 0
    ;;
  *)
    SESSION=$1
    ;;
esac

if ! tmux has-session -t "$SESSION" 2>/dev/null; then
  echo "No tmux session named: $SESSION"
  echo "Available sessions:"
  tmux ls 2>/dev/null || true
  exit 1
fi

exec tmux attach -t "$SESSION"
