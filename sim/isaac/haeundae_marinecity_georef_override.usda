#usda 1.0
(
    defaultPrim = "World"
    subLayers = [
        @./haeundae_marinecity_base_map.usd@
    ]
)

over "CesiumGeoreference"
{
    double cesium:georeferenceOrigin:longitude = 129.145600
    double cesium:georeferenceOrigin:latitude = 35.156900
    double cesium:georeferenceOrigin:height = 160.0
}

def Xform "World"
{
    def Camera "MarineCity_OverviewCamera"
    {
        double focalLength = 28
        float2 clippingRange = (0.1, 10000000)
        double3 xformOp:translate = (0, -650, 420)
        double3 xformOp:rotateXYZ = (58, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        custom string com3d:purpose = "Overview camera for Haeundae MarineCity Cesium georeference smoke test"
        custom string com3d:wgs84_origin = "lat=35.156900, lon=129.145600, height=160m"
    }
}
